{
  "name": "flowchart-sequence-designer",
  "version": "0.1.0",
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "bun-types": "latest",
    "react": "^18",
    "react-dom": "^18",
    "tsup": "^8",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    }
  },
  "description": "TypeScript library for building and editing flowcharts and sequence diagrams — programmatic API, React UI, and multi-format export (Mermaid, PlantUML, SVG, PNG, JSON).",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "flowchart",
    "sequence-diagram",
    "mermaid",
    "plantuml",
    "diagram",
    "react"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "react": {
    "optional": true
  },
  "react-dom": {
  "optional": true
}
},
"scripts": {
  "build": "tsup",
  "dev": "tsup --watch",
  "test": "bun test",
  "typecheck": "tsc --noEmit"
},
"type": "module"
}
