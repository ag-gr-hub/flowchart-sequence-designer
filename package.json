{
  "name": "flowchart-sequence-designer",
  "version": "1.0.0",
  "description": "TypeScript library for building and editing flowcharts and sequence diagrams — programmatic API, React UI, and multi-format export (Mermaid, PlantUML, SVG, PNG, JSON).",
  "license": "MIT",
  "author": "ag-gr-hub",
  "homepage": "https://ag-gr-hub.github.io/flowchart-sequence-designer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ag-gr-hub/flowchart-sequence-designer.git"
  },
  "bugs": {
    "url": "https://github.com/ag-gr-hub/flowchart-sequence-designer/issues"
  },
  "keywords": [
    "flowchart",
    "sequence-diagram",
    "mermaid",
    "plantuml",
    "diagram",
    "react",
    "svg",
    "editor",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "bun-types": "latest",
    "react": "^18",
    "react-dom": "^18",
    "tsup": "^8",
    "typescript": "^5"
  }
}
